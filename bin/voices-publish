#!/usr/bin/env bash
# Publish the Voci data to the VPS. The computation happens here, on the
# workstation, because YouTube refuses caption requests from datacenter IPs
# (docs/PLAN-voices.md §2); the server only serves what this script installs.
#
#   bin/voices-publish            install data/voices.json + data/media/yt/
#   bin/voices-publish --dry-run  print what would be done, touch nothing
#
# Idempotent and safe to re-run. No secret is ever uploaded: the YouTube and
# model keys stay on this machine.
set -euo pipefail
cd "$(dirname "$0")/.."

# The server address is deliberately not in the repository: the origin sits
# behind a Cloudflare Tunnel precisely so that it is never published. It comes
# from the environment or from the git-ignored deploy/deploy.local.env.
_root="$(cd "$(dirname "$0")/.." && pwd)"
[ -f "$_root/deploy/deploy.local.env" ] && . "$_root/deploy/deploy.local.env"
VPS="${MANOR_VPS:?set MANOR_VPS=user@host in the environment or in deploy/deploy.local.env}"
KEY="${MANOR_SSH_KEY:-$HOME/.ssh/id_ed25519}"
DATA_DIR=/var/lib/manor-ledger
OWNER=manor-fetch:manor

DRY_RUN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) echo "unknown option $1" >&2; exit 2 ;;
  esac
  shift
done

[ -f data/voices.json ] || { echo "data/voices.json is missing: run bin/voices first" >&2; exit 1; }
generated=$(sed -n 's/.*"generatedAt":"\([^"]*\)".*/\1/p' data/voices.json | head -1)
images=$(find data/media/yt -name '*.jpg' 2>/dev/null | wc -l)
echo "→ publishing voices.json (generated $generated) and $images thumbnails to $VPS"

run() { if [ "$DRY_RUN" = 1 ]; then printf '  would run:'; printf ' %q' "$@"; echo; else "$@"; fi; }

SSH=(ssh -i "$KEY" -o BatchMode=yes "$VPS")
RSYNC_SSH="ssh -i $KEY -o BatchMode=yes"

# /tmp is world-writable, so anything staged there can be replaced or
# symlinked by another local user between the upload and the privileged
# install. The remote creates a private directory instead — its own, mode 700,
# under /var/tmp — and the name is checked against the template before it is
# allowed anywhere near "ssh sudo".
if [ "$DRY_RUN" = 1 ]; then
  STAGE=/var/tmp/manor-voices.XXXXXX
else
  STAGE=$("${SSH[@]}" 'umask 077 && mktemp -d /var/tmp/manor-voices.XXXXXX')
  case "$STAGE" in
    /var/tmp/manor-voices.??????) ;;
    *) echo "unexpected staging directory from the server: $STAGE" >&2; exit 1 ;;
  esac
  cleanup() { "${SSH[@]}" "rm -rf -- '$STAGE'" >/dev/null 2>&1; return 0; }
  trap cleanup EXIT
fi

run rsync -az --delete --no-links -e "$RSYNC_SSH" data/voices.json data/media/yt "$VPS:$STAGE/"

if [ "$DRY_RUN" = 1 ]; then
  echo "  would run: ssh $VPS sudo install -m 640 -o $OWNER $STAGE/voices.json $DATA_DIR/voices.json"
  echo "  would run: ssh $VPS sudo rsync ... $STAGE/yt/ $DATA_DIR/media/yt/ (0644, $OWNER)"
  exit 0
fi

# One privileged step, with the ownership and modes the two service users need:
# manor-fetch owns the data, the manor web pool only reads it.
"${SSH[@]}" "sudo DATA_DIR='$DATA_DIR' OWNER='$OWNER' STAGE='$STAGE' bash -s" <<'REMOTE'
set -euo pipefail
# Nothing here follows a link: the staging tree was uploaded with --no-links,
# so a link in it would be something that was put there after the upload.
[ -d "$STAGE" ] && [ ! -L "$STAGE" ] || { echo "the staging directory is not a directory" >&2; exit 1; }
[ -f "$STAGE/voices.json" ] && [ ! -L "$STAGE/voices.json" ] || { echo "nothing staged, or a symlink where the document should be" >&2; exit 1; }
[ -z "$(find "$STAGE" -type l -print -quit)" ] || { echo "refusing to install from a tree containing symlinks" >&2; exit 1; }
install -d -m 750 -o "${OWNER%%:*}" -g "${OWNER##*:}" "$DATA_DIR/media" "$DATA_DIR/media/yt"
install -m 640 -o "${OWNER%%:*}" -g "${OWNER##*:}" "$STAGE/voices.json" "$DATA_DIR/voices.json"
# The lock file keeps its old owner across a chown, which would then break the
# next local write: give it the same owner as the document it guards.
[ -f "$DATA_DIR/voices.json.lock" ] && chown "$OWNER" "$DATA_DIR/voices.json.lock"
rsync -a --delete --chown="$OWNER" "$STAGE/yt/" "$DATA_DIR/media/yt/"
find "$DATA_DIR/media/yt" -type f -name '*.jpg' -exec chmod 644 {} +
rm -rf "$STAGE"
echo "installed: $(ls -l "$DATA_DIR/voices.json" | awk '{print $1, $3":"$4, $5}') bytes, $(find "$DATA_DIR/media/yt" -name '*.jpg' | wc -l) thumbnails"
REMOTE

echo "done"
